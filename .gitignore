# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache

# Virtual environments
.venv
.env
.kilo

workspace/
token-use/

# Local session store
sessions.db
sessions.db-*

# Skills: folder shell tracked via .gitkeep; live skills stay local-only
skills/*
!skills/.gitkeep
!skills/llm-wiki/
!skills/llm-wiki/**

# Memory files are tracked as empty placeholders; local agent-curated content
# is hidden from git via skip-worktree (see CLAUDE.md).

# Console-clean diagnostics llm/md
agent.log

# Old OKF llm-wiki: obsolete (replaced by the llm-wiki-v3 skill and wiki/)

# raw/: personal research clippings; local-only, folder shell committed
/raw/*
!/raw/.gitkeep
# Wiki: keep the bootstrapped content local-only (fresh-run users bootstrap their own wiki)
wiki/*
!wiki/.gitkeep

# Python bytecode inside skill scripts (gitignored at the repo level)
skills/**/__pycache__/

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache

# Virtual environments
.venv
.env
.kilo

workspace/
token-use/

# Local session store
sessions.db
sessions.db-*

# Agent state: folder structure tracked via .gitkeep; live content stays local-only
skills/*
!skills/.gitkeep
# The self-evolving llm-wiki skill is explicitly tracked (it carries the
# agent-authored patches); every other skill stays local-only.
!skills/llm-wiki/
!skills/llm-wiki/**

# Memory files are tracked as empty placeholders; local agent-curated content
# is hidden from git via skip-worktree (see CLAUDE.md).

# Console-clean diagnostics llm/md
agent.log

# LLM wiki: folder tracked via .gitkeep; pages stay local-only
llm-wiki/*
!llm-wiki/.gitkeep

# raw/: personal research clippings; local-only, folder shell committed
/raw/*
!/raw/.gitkeep

# Obsidian config (created on vault open) — local-only
wiki/.obsidian/
.obsidian/

# Python bytecode inside skill scripts (gitignored at the repo level)
skills/**/__pycache__/

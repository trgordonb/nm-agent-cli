# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache

# Virtual environments
.venv
.env
.kilo
.zcode

workspace/
token-use/

# Local session store
sessions.db
sessions.db-*


# Memory files are tracked as empty placeholders; local agent-curated content
# is hidden from git via skip-worktree (see CLAUDE.md).

# Console-clean diagnostics llm/md
agent.log

# Old OKF llm-wiki: obsolete (replaced by the llm-wiki-v3 skill and wiki/)

# raw/: personal research clippings; local-only, folder shell committed
/raw/*
!/raw/.gitkeep
# Wiki: keep the bootstrapped content local-only (fresh-run users bootstrap their own wiki)
wiki/*
!wiki/.gitkeep

# Python bytecode inside skill scripts (gitignored at the repo level)
skills/**/__pycache__/

# Skills registry (nm-skills-registry): skills/ is a local mirror of the
# S3-compatible registry (SKILLS_REGISTRY=s3://neuralmatrix); the authoritative
# copies live in the bucket. Registry state + cache index are bucket siblings.
skills/
state/
.nm-skills-registry-index.json

# Frontend build artifacts
frontend/node_modules/
frontend/dist/

# AgentDB MCP pilot (AGENTDB_MCP_PILOT_PLAN.md §2): pinned vendor install,
# ~1 GB node_modules — only package.json + package-lock.json are committed
vendor/agentdb/node_modules/

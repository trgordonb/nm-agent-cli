# NM-Agent-CLI environment configuration.
# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Primary LLM (z.ai / any OpenAI-compatible endpoint) ---
# NOTE: .env overrides shell-exported variables (load_dotenv(override=True)).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.z.ai/api/paas/v4/
LLM_TEMPERATURE=
LLM_MAX_P=

# --- Secondary LLM (OpenRouter): search summarizer + context compressor ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Summarizer currently needs a non-gated :free model, e.g.
#   inclusionai/ling-3.0-flash-vl:free
OPENROUTER_MODEL=

# --- Web research (Jina search + reader) ---
JINA_API_KEY=

# --- Financial data ---
FINANCIAL_MODELING_PREP_API_KEY=
EDGAR_IDENTITY=

# --- LangSmith tracing (optional; logs every LLM/tool call) ---
LANGCHAIN_API_KEY=
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=

# --- Memory layer toggles ---
# Condense session_search excerpts via the OpenRouter model (A/B-able)
SEARCH_SUMMARIZER_ENABLED=true
# Pre-flight context compression with lineage
COMPRESSION_ENABLED=false
COMPRESSION_TOKEN_THRESHOLD=18000
COMPRESSION_KEEP_RECENT_TURNS=1

# --- Overrides (defaults shown) ---
# NUDGE_INTERVAL=5            # turns between memory nudges
# SESSION_DB_PATH=./sessions.db
# MEMORY_DIR=./memories
# SKILLS_DIR=./skills
